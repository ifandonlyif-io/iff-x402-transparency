{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ifandonlyif-io/iff-x402-transparency/main/schemas/observed-confirmations-v1.json",
  "title": "IFF observed-tier daily confirmation document v1",
  "description": "Structure of the canonical body, not the mutable API metadata wrapper. JSON Schema does not establish canonical byte order, sums, uniqueness by URL, timestamps ordering, signatures, completeness, or truth. Hash the original bytes and apply spec/observed-confirmations-v1.md separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "day",
    "monitor_id",
    "state_key_algorithm",
    "fingerprint_version",
    "sealed_at",
    "endpoint_count",
    "omitted_opted_out_endpoints",
    "uncounted_late_results",
    "totals",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "iff-observed-confirmations/v1"
    },
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "monitor_id": {
      "type": "string",
      "minLength": 1
    },
    "state_key_algorithm": {
      "const": "iff-observed-state-key/v1"
    },
    "fingerprint_version": {
      "const": 1
    },
    "sealed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "endpoint_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_opted_out_endpoints": {
      "type": "integer",
      "minimum": 0
    },
    "uncounted_late_results": {
      "type": "integer",
      "minimum": 0
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probes",
        "valid_confirmations",
        "transitions"
      ],
      "properties": {
        "probes": {
          "type": "integer",
          "minimum": 0
        },
        "valid_confirmations": {
          "type": "integer",
          "minimum": 0
        },
        "transitions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "state_key",
        "set_fingerprint",
        "outcome",
        "opened_at",
        "opened_in_day",
        "probes",
        "first_probe_at",
        "last_probe_at",
        "last_valid_at"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state_key": {
          "$ref": "#/$defs/hash"
        },
        "set_fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "valid_requirements",
            "invalid_requirements",
            "non_402",
            "no_information"
          ]
        },
        "opened_at": {
          "$ref": "#/$defs/timestamp"
        },
        "opened_in_day": {
          "type": "boolean"
        },
        "probes": {
          "type": "integer",
          "minimum": 1
        },
        "first_probe_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_probe_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_valid_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "valid_requirements"
              }
            }
          },
          "then": {
            "properties": {
              "set_fingerprint": {
                "$ref": "#/$defs/hash"
              },
              "last_valid_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          },
          "else": {
            "properties": {
              "set_fingerprint": {
                "type": "null"
              },
              "last_valid_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "probes",
        "reachable",
        "protocol_pass",
        "protocol_warn",
        "protocol_fail",
        "protocol_unknown",
        "valid_confirmations",
        "first_probe_at",
        "last_probe_at",
        "episodes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "Normalized public HTTPS URL; UTF-8 path characters are retained in the canonical body. Apply the endpoint URL policy separately."
        },
        "probes": {
          "type": "integer",
          "minimum": 1
        },
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "protocol_pass": {
          "type": "integer",
          "minimum": 0
        },
        "protocol_warn": {
          "type": "integer",
          "minimum": 0
        },
        "protocol_fail": {
          "type": "integer",
          "minimum": 0
        },
        "protocol_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "valid_confirmations": {
          "type": "integer",
          "minimum": 0
        },
        "first_probe_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_probe_at": {
          "$ref": "#/$defs/timestamp"
        },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/episode"
          }
        }
      }
    }
  }
}
